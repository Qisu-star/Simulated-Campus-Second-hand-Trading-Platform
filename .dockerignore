# =============================================================================
# .dockerignore — Exclude unnecessary files from Docker build context
# =============================================================================

# Git
.git/
.gitignore
.gitattributes

# Dependencies (will be installed during build)
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output (will be rebuilt during Docker build)
frontend/.next/
backend/dist/
backend/logs/
backend/run/

# Database files (will be mounted as volume)
backend/data/
data/

# Environment files
.env
.env.*
!.env.example

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test and coverage
coverage/
.nyc_output/

# Logs
*.log
logs/

# Temp files
tmp/
temp/

# Claude
.claude/

# Documentation
*.md
LICENSE

# Docker files (to avoid confusion)
docker-compose.yml
Dockerfile
.dockerignore