{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "bootstrap.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js --kill-timeout 5000",
    "build": "mwtsc --cleanOutDir",
    "start": "cross-env NODE_ENV=production node bootstrap.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "pretest": "npm run build",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mts"
  },
  "dependencies": {
    "@midwayjs/bootstrap": "^4.2.1",
    "@midwayjs/core": "^4.2.1",
    "@midwayjs/koa": "^4.2.1",
    "@midwayjs/logger": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@midwayjs/mock": "^4.2.1",
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "mwtsc": "^1.16.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  }
}
